# Salin ke .env untuk dev lokal (vercel dev). JANGAN commit file .env.
# API key dari Groq Cloud (https://console.groq.com/keys), diawali "gsk_"
AI_API_KEY=gsk_isi_api_key_groq_kamu
# Opsional (nilai default ditampilkan):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_VISION_MODEL=qwen/qwen3.8-27b
# AI_MODEL_LITE=llama-3.1-8b-instant
# AI_MODEL_MAX=openai/gpt-oss-120b

# ---- Login, kuota, dan admin (WAJIB di produksi) ----
# Rahasia untuk menandatangani sesi login. Isi teks acak panjang (min. 16 karakter).
SESSION_SECRET=ganti_dengan_teks_acak_yang_panjang
# Akun admin: masuk lewat halaman /masuk dengan email + kata sandi ini.
ADMIN_EMAIL=emailkamu@gmail.com
ADMIN_PASSWORD=kata_sandi_admin_yang_kuat
# Database Upstash Redis (gratis). Di Vercel: Storage -> Marketplace -> Upstash Redis,
# variabelnya terisi otomatis (KV_REST_API_URL / KV_REST_API_TOKEN juga dikenali).
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=isi_token_upstash
